# ./.gitignore

# Dependencies
# Ignore node_modules folder where npm/yarn installs dependencies
node_modules
# Ignore Yarn Plug'n'Play configuration file *** NOT NEEDED ***
# .pnp
# Ignore Yarn Plug'n'Play JavaScript config *** NOT NEEDED ***
# .pnp.js
# Ignore Yarn install state file *** NOT NEEDED ***
# .yarn/install-state.gz
# Ignore local environment-specific files. Common examples could be .env.local, .docker.local, or similar local configuration files that don’t need to be shared with others.
*.local

# Testing
# Ignore test coverage reports
coverage

# Miscellaneous
# Ignore VSCode workspace project-specific settings (like debug configurations or workspace settings)
.vscode/*
# Include VSCode extension recommendations (an exception to the previous rule)
!.vscode/extensions.json
# Ignore JetBrains IDE settings (e.g., WebStorm, PhpStorm) *** NOT NEEDED ***
# .idea
# Ignore macOS file storing folder attributes
.DS_Store

# Production
# Ignore production build output (e.g., bundled code, compiled code)
# These files are generated by tools like Webpack or Vite.
dist
# Ignore SSR build output (if applicable)
# Might be used for Server-Side Rendering (SSR) output in a framework like Nuxt or Next.js. This folder contains SSR-related build artifacts that don’t need to be committed.
dist-ssr

# Logs
# Ignore all log files
*.log
